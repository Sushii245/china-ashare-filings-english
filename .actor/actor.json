{
  "actorSpecification": 1,
  "name": "china-ashare-filings-english",
  "title": "China A-Share Filings to English (CNINFO)",
  "description": "Turns Chinese A-share regulatory filings from CNINFO into English summaries and structured, source-cited financial data.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "../Dockerfile",
  "readme": "./STORE_README.md",
  "changelog": "./CHANGELOG.md",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "environmentVariables": {
    "ANTHROPIC_API_KEY": "@anthropic-api-key",
    "ANTHROPIC_BASE_URL": "https://aihubmix.com"
  },
  "defaultMemoryMbytes": 1024,
  "maxMemoryMbytes": 4096
}
